# Runtime
NODE_ENV=production

# HiveMQ Cloud
MQTT_HOST=a8805b4f45744c3f9ac83882e423e0c0.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=replace_with_hivemq_username
MQTT_PASS=replace_with_hivemq_password
MQTT_TOPIC=nutrixense/sensor
MQTT_CLIENT_ID=nutrixense-backend

# Firebase Admin SDK
# Use either FIREBASE_SERVICE_ACCOUNT_PATH or FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=
FIRESTORE_COLLECTION=sensor_data

# Optional settings
SAVE_INTERVAL_MS=60000
